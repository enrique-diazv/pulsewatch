APP_ORIGIN=https://pulsewatch.example.com
APP_PORT=8080

DATABASE_PASSWORD=replace-with-a-long-random-database-password
JWT_SECRET_KEY=replace-with-at-least-32-random-characters

WEB_CONCURRENCY=2
WORKER_CONCURRENCY=4

EMAIL_DELIVERY_MODE=smtp
EMAIL_FROM_ADDRESS=alerts@pulsewatch.example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password
SMTP_USE_TLS=false
SMTP_START_TLS=true