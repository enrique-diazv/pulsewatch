APP_NAME=PulseWatch API
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=["http://localhost:5173"]
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=pulsewatch
DATABASE_USER=pulsewatch_app
DATABASE_PASSWORD=replace-with-local-password
REDIS_URL=redis://127.0.0.1:6379/0
DASHBOARD_CACHE_TTL_SECONDS=30
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
MANUAL_CHECK_COOLDOWN_SECONDS=10
SCHEDULER_POLL_INTERVAL_SECONDS=10
SCHEDULER_BATCH_SIZE=100

NOTIFICATION_DISPATCH_INTERVAL_SECONDS=15
NOTIFICATION_BATCH_SIZE=100
NOTIFICATION_MAX_ATTEMPTS=3
EMAIL_DELIVERY_MODE=log
EMAIL_FROM_ADDRESS=alerts@pulsewatch.local
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_START_TLS=false

REALTIME_TICKET_TTL_SECONDS=30
RAW_CHECK_RETENTION_DAYS=30
RETENTION_BATCH_SIZE=10000